# =============================================================================
# OTel Lab — environment (copy to .env and edit)
# =============================================================================

# -----------------------------------------------------------------------------
# 1) Apps → local OpenTelemetry Collector (OTLP/HTTP for everyone)
#    Internal container ports stay 4317 (gRPC) / 4318 (HTTP).
#    Change HOST ports below only if those are already taken on your machine.
# -----------------------------------------------------------------------------
OTEL_COLLECTOR_HOST=otel-collector
OTEL_COLLECTOR_HTTP_PORT=4318
OTEL_COLLECTOR_GRPC_PORT=4317

# Shared by all services (Compose wires this automatically from host/port above)
# Protocol is always http/protobuf for this lab.
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# -----------------------------------------------------------------------------
# 2) Collector → your observability backend
# -----------------------------------------------------------------------------

# --- Option A: OpenObserve (default shape) ---
OTEL_BACKEND_OTLP_HTTP_ENDPOINT=https://api.openobserve.ai/api/default
OTEL_BACKEND_AUTHORIZATION=Basic REPLACE_ME
OTEL_BACKEND_HEADER_ORGANIZATION=default
OTEL_BACKEND_HEADER_STREAM=default

# --- Option B: Another OTel Collector already on the Docker HOST (:4318) ---
# Your other Compose stack (e.g. xd-oss-stack) owns host :4318. Remap THIS lab's
# published ports so they do not clash, then point the backend at the host.
# Compose already sets extra_hosts: host.docker.internal:host-gateway (Linux/WSL).
#
# OTEL_COLLECTOR_HTTP_PORT=14318
# OTEL_COLLECTOR_GRPC_PORT=14317
# OTEL_BACKEND_OTLP_HTTP_ENDPOINT=http://host.docker.internal:4318
# OTEL_BACKEND_AUTHORIZATION=
# OTEL_BACKEND_HEADER_ORGANIZATION=
# OTEL_BACKEND_HEADER_STREAM=
#
# Fallback if host.docker.internal still times out:
# OTEL_BACKEND_OTLP_HTTP_ENDPOINT=http://172.17.0.1:4318
#
# See docs/telemetry.md → "Export to another Collector on localhost"

# Optional Stripe test mode
STRIPE_SECRET_KEY=

# OpenFeature / flagd
FLAGD_HOST=flagd
FLAGD_PORT=8013

# Frontend (browser)
VITE_BFF_URL=http://localhost:3000
# RUM uses same-origin nginx proxy → collector HTTP (leave as /otlp)
VITE_OTEL_EXPORTER_OTLP_ENDPOINT=/otlp
