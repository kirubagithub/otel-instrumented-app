# Backend exporter (Collector → your observability product)
# Apps always send OTLP to the Collector; only change these to switch backends.
#
# OpenObserve (default):
# Endpoint shape: https://api.openobserve.ai/api/<org>
# Authorization: Basic <base64(email:password)>  OR  Basic <token from OpenObserve UI>
# A 403 from the collector means these credentials/org are wrong — apps still run;
# local debug export continues in collector logs.
OTEL_BACKEND_OTLP_HTTP_ENDPOINT=https://api.openobserve.ai/api/default
OTEL_BACKEND_AUTHORIZATION=Basic REPLACE_ME
OTEL_BACKEND_HEADER_ORGANIZATION=default
OTEL_BACKEND_HEADER_STREAM=default
#
# Examples for other backends (uncomment / replace above):
# Grafana Cloud OTLP:
# OTEL_BACKEND_OTLP_HTTP_ENDPOINT=https://otlp-gateway-prod-us-central-0.grafana.net/otlp
# OTEL_BACKEND_AUTHORIZATION=Basic <base64(instanceId:token)>
# OTEL_BACKEND_HEADER_ORGANIZATION=
# OTEL_BACKEND_HEADER_STREAM=
#
# Honeycomb:
# OTEL_BACKEND_OTLP_HTTP_ENDPOINT=https://api.honeycomb.io
# OTEL_BACKEND_AUTHORIZATION=
# (also set header x-honeycomb-team in otel-collector/config.yaml)
#
# OTLP/gRPC backend (enable otlp/backend in config.yaml pipelines):
# OTEL_BACKEND_OTLP_GRPC_ENDPOINT=tempo:4317
# OTEL_BACKEND_OTLP_GRPC_TLS_INSECURE=true

# Optional Stripe test mode
STRIPE_SECRET_KEY=

# OpenFeature / flagd
FLAGD_HOST=flagd
FLAGD_PORT=8013

# Frontend
VITE_BFF_URL=http://localhost:3000
VITE_OTEL_EXPORTER_OTLP_ENDPOINT=/otlp
