# OpenObserve OTLP exporter (required for telemetry)
# Example: https://api.openobserve.ai/api/<org>
OPENOBSERVE_OTLP_ENDPOINT=https://api.openobserve.ai/api/default
# Basic auth header value, e.g. Basic <base64(email:password)> or your API token format
# OpenObserve typically expects: Authorization=Basic <token>
OPENOBSERVE_AUTHORIZATION=Basic REPLACE_ME

# Optional: stream / org overrides used in collector headers
OPENOBSERVE_ORG=default
OPENOBSERVE_STREAM=default

# Optional Stripe test mode (leave empty to skip Stripe spans)
STRIPE_SECRET_KEY=

# Frontend → BFF URL (browser-accessible)
VITE_BFF_URL=http://localhost:3000
VITE_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
